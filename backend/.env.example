# Server
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed browser origins. Credentials are enabled, so this
# must never be "*".
FRONTEND_ORIGIN=http://localhost:3000

# Auth — JWT is set as an httpOnly cookie. Generate with `openssl rand -base64 48`;
# the API refuses to boot on anything shorter than 32 characters, and on a copy of the
# placeholder this file used to ship.
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_ISSUER=booking-api
JWT_AUDIENCE=booking-web

# Database. DATABASE_URL is the POOLED connection used at runtime; DIRECT_URL is the
# direct one used by the Prisma CLI for migrations. Getting these backwards exhausts
# the Neon connection budget. See context/library-docs.md.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&connect_timeout=10"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# OAuth — optional in local dev. Callback URLs must be registered with each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# Stripe — test mode only. Test card 4242 4242 4242 4242, any future expiry, any CVC.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phase 5 only
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=bookings@example.com
