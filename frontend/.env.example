# Site
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# API base used by the BROWSER. Must be NUXT_PUBLIC_* to reach the client.
NUXT_PUBLIC_API_BASE=http://localhost:3000/api

# API base used for SSR server-side fetches. Server-only, no prefix.
NUXT_API_BASE_URL=http://localhost:3000/api

# OAuth callback base. The backend redirects here after the provider handshake.
NUXT_PUBLIC_OAUTH_REDIRECT_BASE=http://localhost:3000
